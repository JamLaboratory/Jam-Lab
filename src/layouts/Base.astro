---
const { title = 'Jam Laboratory', description = 'An independent music journal. A study in sound.' } = Astro.props;
const nav = [{label:'Home',url:'/'},{label:'Reviews',url:'/reviews/'},{label:'Artists',url:'/artists/'},{label:'Rankings',url:'/rankings/'},{label:'Live',url:'/live/'},{label:'About',url:'/about/'}];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><title>{title} | Jam Laboratory</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head>
<body>
<header class="masthead"><div class="eyebrow">AN INDEPENDENT MUSIC JOURNAL <span>✦</span> EST. MMXXVI</div><a class="wordmark" href="/">JAM LABORATORY</a><div class="tagline">A Study in Sound.</div></header>
<nav class="mainnav" aria-label="Main navigation"><div class="navinner">{nav.map(item=><a class={Astro.url.pathname===item.url?'active':''} href={item.url}>{item.label}</a>)}</div></nav>
<main><slot/></main><footer><div class="footerline"></div><div class="footercontent"><strong>JAM LABORATORY</strong><span>Good records. Strong opinions. Endless discovery.</span><span>© {new Date().getFullYear()} Jam Laboratory</span></div></footer>
</body></html>
<style is:global>
@font-face{font-family:AnchorJack;src:url('/fonts/anchor-jack.ttf') format('truetype');font-display:swap}
@font-face{font-family:Josefin;src:url('/fonts/josefin-sans.ttf') format('truetype');font-style:normal;font-weight:100 700;font-display:swap}
@font-face{font-family:Josefin;src:url('/fonts/josefin-sans-italic.ttf') format('truetype');font-style:italic;font-weight:100 700;font-display:swap}
:root{--cream:#f5f0e3;--green:#214b3b;--gold:#b69a55;--ink:#30342c;--sage:#a5ad91;--line:#d8d0bc}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font:400 19px/1.65 Josefin,Georgia,serif}a{color:var(--green)}a:hover{color:#8b6935}.masthead{text-align:center;padding:30px 18px 25px}.eyebrow{font:600 11px/1.4 Josefin,sans-serif;letter-spacing:3px;color:var(--green)}.eyebrow span{color:var(--gold);padding:0 12px}.wordmark{display:block;font:normal clamp(38px,7.8vw,94px)/1.13 AnchorJack,Georgia,serif;letter-spacing:1px;text-decoration:none;color:var(--green);margin:12px auto 3px}.tagline{font:italic 19px Josefin,serif;color:#77765c}.mainnav{background:var(--green);border-top:3px solid var(--gold);border-bottom:3px solid var(--gold)}.navinner{max-width:1100px;margin:auto;display:flex;justify-content:center;flex-wrap:wrap}.navinner a{font:normal 17px AnchorJack,Georgia,serif;letter-spacing:.6px;color:var(--cream);text-decoration:none;padding:15px 20px}.navinner a:hover,.navinner a.active{background:#356550;color:#f5dc98}main{max-width:1100px;margin:0 auto;padding:40px 24px 80px;min-height:60vh}.kicker{font-size:12px;letter-spacing:2px;text-transform:uppercase;font-weight:700;color:#866b34}.sectiontitle,h1,h2,h3{font-family:AnchorJack,Georgia,serif;font-weight:400;line-height:1.2;color:var(--green)}h1{font-size:clamp(36px,5vw,66px);margin:12px 0 16px}h2{font-size:clamp(26px,3vw,39px)}h3{font-size:25px}.lead{font-size:clamp(20px,2.6vw,27px);line-height:1.5;max-width:750px}.rule{height:2px;background:var(--gold);margin:28px 0}.cardgrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{border:1px solid var(--line);background:#faf7ef;padding:24px;min-height:200px}.card h3{margin:10px 0}.card p{margin:0}.card a{text-decoration:none}.small{font-size:15px;color:#62675b}.button{display:inline-block;background:var(--green);color:var(--cream);padding:11px 19px;text-decoration:none;font:normal 17px AnchorJack,serif}.button:hover{background:#356550;color:white}.footerline{height:4px;background:var(--gold)}footer{background:var(--green);color:var(--cream)}.footercontent{max-width:1100px;margin:auto;padding:30px 24px;display:flex;gap:15px;justify-content:space-between;align-items:center;flex-wrap:wrap;font-size:14px}.footercontent strong{font:22px AnchorJack,serif;color:#e0c987}.hero{display:grid;grid-template-columns:1.4fr 1fr;gap:32px;align-items:center;padding:22px 0 36px}.heroart{min-height:320px;background:repeating-radial-gradient(circle at 50% 50%,#1e3d32 0 6px,#2b5544 7px 10px,#b69a55 11px 12px,#17372d 13px 20px);border:12px solid #d8c9a7;display:flex;align-items:center;justify-content:center}.heroart span{display:grid;place-items:center;border-radius:50%;background:var(--cream);width:110px;height:110px;color:var(--green);font:30px AnchorJack,serif;border:8px solid var(--gold)}@media(max-width:750px){.hero{grid-template-columns:1fr}.cardgrid{grid-template-columns:1fr}.navinner a{padding:13px 11px;font-size:14px}.heroart{min-height:240px}.masthead{padding:22px 12px}.eyebrow{letter-spacing:1.4px;font-size:9px}main{padding:28px 18px 60px}}
</style>
