---
import Engagement from '../../components/Engagement.astro';
import Base from '../../layouts/Base.astro';import {reviews,scoreFor,dateLabel} from '../../lib/content.js';
export function getStaticPaths(){return reviews.map(r=>({params:{slug:r.slug},props:{review:r}}))}
const {review}=Astro.props;const categories=['composition','writing','performance','production','intangibles'];
---
<Base title={`${review.artist} — ${review.album}`}><div class="kicker">ALBUM REVIEW · BY NICK WALSH · {dateLabel(review.published)}</div><div class="reviewhero"><div class="cover">{review.cover?<img src={review.cover} alt={`${review.album} cover`}/>: 'ALBUM ART'}</div><div><h1>{review.album}</h1><p class="lead">{review.artist}</p><p class="muted">{review.year} · {review.genre}</p><div class="kicker">JAM LAB SCORE</div><div class="overall">{scoreFor(review.scores).toFixed(1)} <span class="small">/ 10</span></div>{categories.map(c=><div class="score-row"><span>{c[0].toUpperCase()+c.slice(1)}</span><div class="score-track"><div class="score-fill" style={`width:${review.scores[c]*10}%`}></div></div><strong>{review.scores[c].toFixed(1)}</strong></div>)}</div></div><hr class="rule"/><div class="prose">{review.body.map(p=><p>{p}</p>)}</div><Engagement type="review" slug={review.slug}/></Base>
