---
import Base from '../../layouts/Base.astro';
import {albums,honorableMentions} from '../../lib/topAlbums2026.js';
const dateLabel = (iso) => new Date(iso+'T12:00:00Z').toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'});
---
<Base title="Top 25 Albums of 2026" description="Jam Lab's favorite 25 albums of 2026, plus honorable mentions.">
  <div class="kicker">JAM LAB RANKINGS · 2026</div>
  <h1>Top 25 Albums of 2026</h1><p class="byline">By Nick Walsh · November 19, 2026</p>
  <p class="lead">Twenty-five records that defined our listening year. No Good Song Left Behind.</p>
  <!-- Approved vintage artist collage to be added after uploading the image asset. -->
  <hr class="rule"/>
  <div class="album-list">
    {albums.map(album => <article class="album-entry">
      <div class="album-art">{album.cover ? <img src={album.cover} alt={album.title+' album cover'} loading="lazy"/> : <span aria-label="Album artwork pending">ARTWORK PENDING</span>}</div>
      <div><div class="kicker">#{album.rank}</div><h2>{album.title}</h2><p>{album.artist}</p><div class="small">Released {dateLabel(album.released)}</div></div>
    </article>)}
  </div>
  <hr class="rule"/><h2>Honorable Mentions</h2>
  <div class="album-list">{honorableMentions.map(album => <article class="album-entry">
    <div class="album-art">{album.cover ? <img src={album.cover} alt={album.title+' album cover'} loading="lazy"/> : <span>ARTWORK PENDING</span>}</div>
    <div><h3>{album.title}</h3><p>{album.artist}</p><div class="small">Released {dateLabel(album.released)}</div></div>
  </article>)}</div>
<footer class="signature"><em>Nick Walsh</em><p>November 19, 2026</p></footer></Base>
<style>.byline{font-size:.9rem;letter-spacing:.04em}.signature{text-align:right;padding:2rem 0}.signature em{font-size:1.5rem}
.album-list{display:grid;gap:1.25rem;margin:2rem 0}.album-entry{display:grid;grid-template-columns:110px 1fr;align-items:center;gap:1.5rem;padding-bottom:1.25rem;border-bottom:1px solid #b69a5560}.album-entry h2,.album-entry h3{margin:.25rem 0}.album-entry p{margin:.25rem 0}.album-art{aspect-ratio:1;background:#f5f0e3;border:1px solid #b69a55;display:grid;place-items:center;overflow:hidden}.album-art img{width:100%;height:100%;object-fit:cover}.album-art span{font-size:.6rem;letter-spacing:.06em;color:#214b3b;text-align:center;padding:.5rem}@media(min-width:700px){.album-entry{grid-template-columns:150px 1fr}}
</style>
