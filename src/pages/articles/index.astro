---
import Base from '../../layouts/Base.astro';import {articles,dateLabel} from '../../lib/content.js';
const sorted=[...articles].sort((a,b)=>b.published.localeCompare(a.published));
---
<Base title="Articles"><div class="kicker">THE WRITTEN WORD</div><h1>Jam Lab Articles</h1><p class="lead">Stories, discoveries, and reflections from across the musical landscape.</p><hr class="rule"/>{sorted.length?<div class="archive">{sorted.map(a=><article><div class="kicker">{dateLabel(a.published)}</div><h2><a href={`/articles/${a.slug}/`}>{a.title}</a></h2><p>{a.description}</p></article>)}</div>:<div class="empty">Articles will appear here as they're published.</div>}</Base>
