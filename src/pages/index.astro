---
import Base from '../layouts/Base.astro';
import SundayJamSignup from '../components/SundayJamSignup.astro';
import {articles,reviews,rankings,scoreFor,dateLabel} from '../lib/content.js';
const latest=[...articles].sort((a,b)=>b.published.localeCompare(a.published)).slice(0,3);
const recent=[...reviews].sort((a,b)=>b.published.localeCompare(a.published)).slice(0,5);
const featured=[...rankings].filter(r=>r.featured).slice(0,3);
---
<Base title="Home"><section class="welcome"><div class="kicker">WELCOME TO THE JOURNAL</div><h1>Welcome to Jam Laboratory: No Good Song Left Behind</h1><p>Jam Laboratory is an independent music journal dedicated to the exploration and dissemination of musical works old and new. Experience in real time with the main editor, me, Nick Walsh, as I uncover and parse the eternal soundscape.</p><p>This is a personal project, built for the pure joy of music and its meaning.</p></section>
<hr class="rule"/><section><div class="sectionhead"><h2>Latest Articles</h2><a href="/articles/">All articles</a></div>{latest.length?<div class="story-grid">{latest.map(a=><article class="card"><a href={`/articles/${a.slug}/`}><div class="cover">{a.hero?<img src={a.hero} alt=""/>:'ARTICLE IMAGE'}</div><div class="kicker">{dateLabel(a.published)}</div><h3>{a.title}</h3></a><p>{a.description}</p></article>)}</div>:<div class="empty">Original articles will appear here as they're published.</div>}</section>
<hr class="rule"/><section><div class="sectionhead"><h2>Recently Reviewed Albums</h2><a href="/reviews/">All reviews</a></div>{recent.length?<div class="grid5">{recent.map(r=><article><a href={`/reviews/${r.slug}/`}><div class="cover">{r.cover?<img src={r.cover} alt={`${r.album} cover`}/>: 'ALBUM ART'}</div><div class="small">{r.artist}</div><h3>{r.album}</h3><div class="score">{scoreFor(r.scores).toFixed(1)}</div></a></article>)}</div>:<div class="empty">The first album reviews are coming soon.</div>}</section>
<hr class="rule"/><section><div class="sectionhead"><h2>Featured Rankings</h2><a href="/rankings/">All rankings</a></div>{featured.length?<div class="grid3">{featured.map((r,i)=><article class={i===0?'rankfeature':'card'}><div class="kicker">FEATURED RANKING</div><h3><a href={`/rankings/${r.slug}/`}>{r.title}</a></h3><p>{r.description}</p></article>)}</div>:<div class="rankfeature"><h3>Rankings worth debating.</h3><p>Featured Jam Lab rankings will appear here once published.</p></div>}</section>
<hr class="rule"/><SundayJamSignup variant="featured" />
</Base>
